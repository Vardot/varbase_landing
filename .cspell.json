{
  "version": "0.2",
  "language": "en-US",
  "allowCompoundWords": false,
  "globRoot": ".",
  "ignorePaths": [
    "node_modules/**",
    "vendor/**",
    "*.min.js",
    "*.min.css",
    "composer.lock",
    "package-lock.json",
    "yarn.lock",
    "**/.*.json",
    ".*ignore"
  ],
  "words": [
    "varbase",
    "Varbase",
    "Vardot",
    "vardot",
    "phpcs",
    "phpcbf",
    "drupal",
    "Drupal",
    "jsonapi",
    "langcode",
    "metatag",
    "restui",
    "oembed",
    "yoast",
    "heroslider",
    "redoc",
    "isset",
    "sprintf",
    "Symfony",
    "KEYTYPE",
    "LANGCODE",
    "Paragraphs",
    "paragraphs",
    "devDependencies",
    "browserslist",
    "maxlength",
    "pathauto",
    "loadjs",
    "autocollapse",
    "optimin",
    "optimax",
    "webform"
  ]
}
